
{
  "name": "curcumin-complex-hub",
  "version": "2.6.0",
  "private": true,
  "description": "Infraestructura de observabilidad y pre-lander de alta conversión para Curcumin Complex.",
  "author": "IA Ingeniera de Software Senior v2.0",
  "scripts": {
    "dev": "next dev | pnpm pino-pretty --colorize --translateTime \"SYS:HH:MM:ss.l\" --ignore \"pid,hostname,service\" --singleLine",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality:check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "db:push": "supabase db push",
    "diag:schema": "tsx --tsconfig tsconfig.json scripts/supabase/diagnose-schema.ts",
    "diag:content": "tsx --tsconfig tsconfig.json scripts/supabase/diagnose-content.ts",
    "diag:all": "pnpm diag:schema && pnpm diag:content",
    "gen:i18n:manifest": "tsx --tsconfig tsconfig.json scripts/i18n/generate-manifest.ts",
    "gen:i18n:schema": "tsx --tsconfig tsconfig.json scripts/i18n/generate-schema.ts",
    "gen:i18n": "pnpm gen:i18n:manifest && pnpm gen:i18n:schema",
    "gen:all": "pnpm gen:i18n"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.5.4",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^8.21.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.2.0",
    "framer-motion": "^11.3.18",
    "gray-matter": "^4.0.3",
    "jquery": "^3.7.1",
    "lucide-react": "^0.417.0",
    "negotiator": "^0.6.3",
    "next": "14.2.5",
    "next-client-cookies": "^1.1.1",
    "next-intl": "^3.17.2",
    "next-mdx-remote": "^5.0.0",
    "pino": "^9.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@next/bundle-analyzer": "^15.5.2",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/jquery": "^3.5.33",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.4",
    "autoprefixer": "^10.4.19",
    "chalk": "^5.4.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vitest": "^0.4.1",
    "globals": "^15.8.0",
    "husky": "^9.1.4",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.1.1",
    "pino-pretty": "^11.2.1",
    "pino-sentry-transport": "^1.2.0",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "3.4.7",
    "tailwindcss-debug-screens": "^2.2.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.0.4"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
